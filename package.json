{
  "name": "geo-areas-workspace",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm --filter @idux/geo-areas run build",
    "test": "pnpm --filter @idux/geo-areas run test",
    "check": "pnpm --filter @idux/geo-areas run check",
    "typecheck": "pnpm --filter @idux/geo-areas run typecheck",
    "update:data": "pnpm --filter @idux/geo-areas run update:data",
    "start": "pnpm build && pnpm --filter @idux/geo-areas-site dev",
    "site:build": "pnpm build && pnpm --filter @idux/geo-areas-site build",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "audit:data": "pnpm build && pnpm --filter @idux/geo-areas run audit:data",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "test:coverage": "pnpm --filter @idux/geo-areas run test:coverage",
    "docs:sync": "pnpm --filter @idux/geo-areas run docs:sync",
    "check:repository": "node .github/scripts/check-repository.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "c8": "^12.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,vue}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,yaml,yml,md,html,css}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "author": "IDuxFE <idux.feteam@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IDuxFE/geo-areas.git"
  },
  "homepage": "https://iduxfe.github.io/geo-areas/",
  "bugs": {
    "url": "https://github.com/IDuxFE/geo-areas/issues"
  },
  "packageManager": "pnpm@10.34.9"
}
