{
  "name": "geo-areas-workspace",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @idux/geo-areas run build",
    "test": "pnpm --filter @idux/geo-areas run test",
    "check": "pnpm --filter @idux/geo-areas run check",
    "typecheck": "pnpm --filter @idux/geo-areas run typecheck",
    "update:data": "pnpm --filter @idux/geo-areas run update:data",
    "playground": "pnpm build && pnpm --filter @idux/geo-areas-playground dev",
    "playground:build": "pnpm build && pnpm --filter @idux/geo-areas-playground build",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "audit:data": "pnpm build && pnpm --filter @idux/geo-areas run audit:data",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "test:coverage": "pnpm --filter @idux/geo-areas run test:coverage"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "c8": "^12.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,vue}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,yaml,yml,md,html,css}": "oxfmt --write --no-error-on-unmatched-pattern"
  }
}
